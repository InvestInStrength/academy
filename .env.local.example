# -----------------------------------------------------------------------------
# Invest in Strength — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). NEVER commit `.env.local`.
# -----------------------------------------------------------------------------

# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key (safe to expose; RLS protects the data, not the key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC
# and never reference it from client code. Used by later trusted server flows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed app (used for verification/certificate links).
# For local dev this is http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional email for sending certificates). SERVER ONLY.
# Without these, certificate email is simply disabled (everything else works).
# RESEND_FROM must be a verified sender, e.g. "INVEST IN STRENGTH <noreply@yourdomain>".
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=INVEST IN STRENGTH <noreply@example.com>

# Upstash Redis (durable rate limiting). SERVER ONLY. Optional.
# Without these, rate limiting falls back to a per-process in-memory store,
# which does NOT span serverless instances or survive redeploys. Set both
# before production traffic. Create a database at https://console.upstash.com
# and copy the REST URL + token (Database -> REST API).
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# NOTE: on Vercel, the Upstash Marketplace integration injects the SAME
# credentials under different names — KV_REST_API_URL / KV_REST_API_TOKEN.
# src/lib/rate-limit.ts accepts either pair (preferring the UPSTASH_* names),
# so a Vercel project with the integration attached needs no extra env vars.
# Do NOT point the limiter at KV_REST_API_READ_ONLY_TOKEN: it issues INCR.
